{
  "name": "heroku-code-mcp",
  "version": "0.1.0",
  "description": "Heroku MCP server with Cloudflare-style search and execute tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "heroku-code-mcp": "dist/index.js"
  },
  "mcpName": "io.github.dsouzaAnush/heroku-code-mcp",
  "files": [
    "assets",
    "dist/*.js",
    "dist/**/*.js",
    "scripts",
    ".env.example",
    "BENCHMARKS.md",
    "LICENSE",
    "README.md",
    "REFERENCES.md",
    "server.json"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "validate:server": "node scripts/validate-server-json.mjs",
    "publish:dry-run": "npm pack --dry-run",
    "build:mcpb": "python3 scripts/build-claude-desktop-mcpb.py",
    "seed:token": "node scripts/seed-token-from-heroku-cli.mjs",
    "smoke:mcp": "node scripts/mcp-smoke-test.mjs"
  },
  "keywords": [
    "mcp",
    "heroku",
    "oauth",
    "platform-api",
    "claude",
    "cursor",
    "codex",
    "openai"
  ],
  "author": "Anush Dsouza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsouzaAnush/heroku-code-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dsouzaAnush/heroku-code-mcp/issues"
  },
  "homepage": "https://github.com/dsouzaAnush/heroku-code-mcp#readme",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
